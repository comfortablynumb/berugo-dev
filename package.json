{
  "name": "berugo-dev",
  "version": "1.0.0",
  "description": "Browser-based developer tools SPA",
  "scripts": {
    "build": "tailwindcss -i ./src/css/main.css -o ./dist/css/main.css --minify",
    "dev": "concurrently --names \"css,http\" --prefix-colors \"cyan,green\" \"npm run dev:css\" \"npm run dev:serve\"",
    "dev:css": "tailwindcss -i ./src/css/main.css -o ./dist/css/main.css --watch",
    "dev:serve": "serve . -p 3000"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "serve": "^14.0.0",
    "tailwindcss": "^3.4.0"
  }
}
